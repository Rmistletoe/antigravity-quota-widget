<Window x:Class="AntigravityQuota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Quota"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- 进度条样式 -->
        <Style x:Key="LightProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="#E2E8F0" Height="{TemplateBinding Height}"/>
                            <Border x:Name="PART_Track" CornerRadius="3" ClipToBounds="True">
                                <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Border CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                                </Decorator>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自定义悬停卡片 ToolTip 样式 (浅色高级磨砂质感) -->
        <Style x:Key="LightToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="VerticalOffset" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border CornerRadius="12"
                                Background="#FDFEFF"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Padding="14,12"
                                Width="260">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.15" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 右键菜单 -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="🔄 立即刷新数据" Click="MenuRefresh_Click"/>
            <MenuItem x:Name="MenuTopmostItem" Header="📌 始终置顶" IsChecked="True" Click="MenuTopmost_Click"/>
            <Separator/>
            <MenuItem Header="❌ 退出程序" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="10">
        <!-- 纯粹常驻浅色胶囊悬浮球 (Pill) -->
        <Border x:Name="PillBorder"
                CornerRadius="18"
                Background="#F2FFFFFF"
                BorderBrush="#D0CBD5E1"
                BorderThickness="1"
                Padding="12,5"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12" Color="#0F172A"/>
            </Border.Effect>

            <!-- 鼠标悬停详情卡片 -->
            <Border.ToolTip>
                <ToolTip Style="{StaticResource LightToolTipStyle}">
                    <StackPanel>
                        <!-- 账号信息 -->
                        <TextBlock x:Name="TipUserText" Text="👤 加载中..." FontSize="11" Foreground="#64748B" FontWeight="Medium" Margin="0,0,0,8"/>
                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,8"/>

                        <!-- 各模型详情列表 -->
                        <StackPanel x:Name="TipModelsContainer" Margin="0,0,0,8"/>

                        <!-- 倒计时提示 -->
                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,0,0,6"/>
                        <Grid>
                            <TextBlock Text="5小时 Sprint 重置:" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TipCountdownText" Text="--:--:-- 后" FontSize="10" Foreground="#475569" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ToolTip>
            </Border.ToolTip>

            <!-- 胶囊内容 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 呼吸发光灯 -->
                <Ellipse x:Name="PillStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="PillStatusGlow" BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 模型百分比 (3.7 Flash) -->
                <TextBlock x:Name="PillPctText" Text="3.7 Flash: --%" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>

                <!-- 分隔条 -->
                <Rectangle Width="1" Height="11" Fill="#CBD5E1" Margin="7,0,7,0"/>

                <!-- 倒计时 -->
                <TextBlock Text="⏳" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PillCountdownText" Text="--:--:--" FontSize="11.5" Foreground="#475569" FontWeight="Medium" VerticalAlignment="Center"/>

                <!-- 快速关闭按钮 (✕) -->
                <Border x:Name="BtnClosePill"
                        Width="16" Height="16" CornerRadius="8"
                        Background="#0D000000"
                        Margin="7,0,0,0"
                        Cursor="Hand"
                        ToolTip="关闭悬浮球"
                        MouseLeftButtonDown="BtnClose_MouseLeftButtonDown"
                        MouseEnter="BtnClose_MouseEnter"
                        MouseLeave="BtnClose_MouseLeave">
                    <TextBlock x:Name="ClosePillText" Text="✕" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
